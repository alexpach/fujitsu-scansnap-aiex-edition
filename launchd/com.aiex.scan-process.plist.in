<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh fills in @HOME@ and @PREFIX@ (the Homebrew prefix) and writes the
     result to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.aiex.scan-process</string>
	<!-- Process queued scans (OCR, split, name). Runs at login to pick up leftovers, and when
	     scan-to-pdf kickstarts it after a scan; exits when the queue is empty. -->
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.local/bin/scan-to-pdf</string>
		<string>--worker</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Background work: don't make the desktop sluggish. -->
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- launchd's default PATH has no Homebrew in it -->
		<key>PATH</key>
		<string>@PREFIX@/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/scan-process.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/scan-process.log</string>
</dict>
</plist>
